{
  "name": "itsjustvita/laravel-bfsg",
  "description": "BFSG and WCAG 2.1 accessibility checks for Laravel: a CI-ready check command, middleware, reports, English and German messages, and an MCP server",
  "keywords": [
    "laravel",
    "accessibility",
    "a11y",
    "wcag",
    "bfsg",
    "barrierefreiheit",
    "european-accessibility-act",
    "mcp"
  ],
  "homepage": "https://github.com/itsjustvita/laravel-bfsg",
  "license": "MIT",
  "authors": [
    {
      "name": "Vitalis Feist-Wurm",
      "email": "hello@itsjustvita.com"
    }
  ],
  "support": {
    "issues": "https://github.com/itsjustvita/laravel-bfsg/issues",
    "source": "https://github.com/itsjustvita/laravel-bfsg"
  },
  "require": {
    "php": "^8.2",
    "ext-dom": "*",
    "ext-libxml": "*",
    "ext-mbstring": "*",
    "guzzlehttp/guzzle": "^7.8.2 || ^8.0",
    "guzzlehttp/psr7": "^2.6.2 || ^3.0",
    "illuminate/console": "^12.0 || ^13.0",
    "illuminate/contracts": "^12.0 || ^13.0",
    "illuminate/database": "^12.0 || ^13.0",
    "illuminate/http": "^12.0 || ^13.0",
    "illuminate/process": "^12.0 || ^13.0",
    "illuminate/support": "^12.0 || ^13.0",
    "illuminate/view": "^12.0 || ^13.0",
    "symfony/css-selector": "^7.0 || ^8.0",
    "symfony/process": "^7.0 || ^8.0"
  },
  "require-dev": {
    "barryvdh/laravel-dompdf": "^3.0",
    "laravel/mcp": "^0.6.4 || ^1.0",
    "laravel/pint": "^1.0",
    "orchestra/testbench": "^10.0 || ^11.0",
    "phpunit/phpunit": "^11.5 || ^12.0"
  },
  "suggest": {
    "laravel/mcp": "Required for the MCP server and the bfsg:mcp-server command (^0.6.4 || ^1.0)",
    "barryvdh/laravel-dompdf": "Required for PDF report generation (^3.0)"
  },
  "conflict": {
    "laravel/mcp": "<0.6.4"
  },
  "autoload": {
    "psr-4": {
      "ItsJustVita\\LaravelBfsg\\": "src/",
      "ItsJustVita\\LaravelBfsg\\Database\\Factories\\": "database/factories/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "ItsJustVita\\LaravelBfsg\\Tests\\": "tests/"
    }
  },
  "extra": {
    "branch-alias": {
      "dev-main": "3.x-dev"
    },
    "laravel": {
      "providers": [
        "ItsJustVita\\LaravelBfsg\\BfsgServiceProvider"
      ],
      "aliases": {
        "Bfsg": "ItsJustVita\\LaravelBfsg\\Facades\\Bfsg"
      }
    }
  },
  "scripts": {
    "test": "phpunit",
    "lint": "pint --test",
    "fix": "pint"
  },
  "prefer-stable": true
}
