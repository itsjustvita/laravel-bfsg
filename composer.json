{
  "name": "itsjustvita/laravel-bfsg",
  "description": "Laravel Package für BFSG/WCAG Barrierefreiheit Compliance",
  "keywords": [
    "laravel",
    "accessibility",
    "bfsg",
    "wcag",
    "a11y"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Vitalis Feist-Wurm",
      "email": "hello@itsjustvita.com"
    }
  ],
  "require": {
    "php": "^8.2",
    "ext-dom": "*",
    "ext-libxml": "*",
    "ext-mbstring": "*",
    "illuminate/console": "^12.0 || ^13.0",
    "illuminate/contracts": "^12.0 || ^13.0",
    "illuminate/database": "^12.0 || ^13.0",
    "illuminate/http": "^12.0 || ^13.0",
    "illuminate/process": "^12.0 || ^13.0",
    "illuminate/support": "^12.0 || ^13.0",
    "illuminate/view": "^12.0 || ^13.0",
    "symfony/css-selector": "^7.0 || ^8.0",
    "symfony/process": "^7.0 || ^8.0"
  },
  "require-dev": {
    "barryvdh/laravel-dompdf": "^3.0",
    "laravel/mcp": "^0.6.4 || ^1.0",
    "laravel/pint": "^1.0",
    "orchestra/testbench": "^10.0 || ^11.0",
    "phpunit/phpunit": "^11.5 || ^12.0"
  },
  "suggest": {
    "laravel/mcp": "Required for the MCP server and the bfsg:mcp-server command (^0.6.4 || ^1.0)",
    "barryvdh/laravel-dompdf": "Required for PDF report generation (^3.0)",
    "pestphp/pest-plugin-browser": "Required for browser-based accessibility testing of SPAs (^0.1)"
  },
  "autoload": {
    "psr-4": {
      "ItsJustVita\\LaravelBfsg\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "ItsJustVita\\LaravelBfsg\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "ItsJustVita\\LaravelBfsg\\BfsgServiceProvider"
      ],
      "aliases": {
        "Bfsg": "ItsJustVita\\LaravelBfsg\\Facades\\Bfsg"
      }
    }
  },
  "scripts": {
    "test": "phpunit",
    "lint": "pint --test",
    "fix": "pint"
  },
  "prefer-stable": true
}
